# Server
HOST=127.0.0.1
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=replace-with-your-local-postgres-password
PGDATABASE=dribble_db

# Vite client endpoints
VITE_API_BASE_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001

# Optional HTTPS: keep both files outside this repository.
# Leave empty for local HTTP/WebSocket development.
SSL_KEY_PATH=
SSL_CERT_PATH=
